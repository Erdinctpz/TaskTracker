@using TaskTracker.Domain.DTOs
@model RegisterDto

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kayıt Ol - Task Tracker</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/register.css">
</head>

<body>
    <div class="d-flex min-vh-100 justify-content-center align-items-center">
        
        <div class="card shadow-lg register-card p-4 my-4">
            
            <h3 class="text-center mb-4 fw-bold">Yeni Hesap Oluştur</h3>
            <div id="alert-message" class="alert alert-dismissible fade show d-none" role="alert"></div>
            <form id="registerForm" novalidate>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <input type="text" asp-for="FirstName" class="form-control" placeholder=" ">
                            <label asp-for="FirstName">Adınız</label>
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="form-floating">
                            <input type="text" asp-for="LastName" class="form-control" placeholder=" ">
                            <label asp-for="LastName">Soyadınız</label>
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-floating mb-3">
                    <input type="text" asp-for="UserName" class="form-control" placeholder=" ">
                    <label asp-for="UserName">Kullanıcı adı</label>
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input type="email" asp-for="Email" class="form-control" placeholder=" ">
                    <label asp-for="Email">E-posta adresi</label>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-3">
                    <input type="password" asp-for="Password" id="Password" class="form-control" placeholder=" ">
                    <label asp-for="Password">Şifre</label>
                    <i id="togglePassword" 
                        class="bi bi-eye position-absolute top-50 end-0 translate-middle-y me-3" 
                        style="cursor:pointer;"></i>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="form-floating mb-4">
                    <input type="password" asp-for="ConfirmPassword" id="ConfirmPassword" class="form-control" placeholder=" ">
                    <label asp-for="ConfirmPassword">Şifre Tekrar</label>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-success py-2 fw-bold text-white">Kayıt Ol</button>
                </div>

            </form>

            <div class="text-center">
                <small>Zaten bir hesabınız var mı? <a href="@Url.Action("Login", "Auth")" class="fw-semibold text-decoration-none">Giriş yapın</a></small>
            </div>

        </div>
    </div>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        $(document).ready(function() {
            $("#togglePassword").on('click', function() {
                const passwordInput = $("#Password");
                const confirmInput = $("#ConfirmPassword");
                const type = passwordInput.attr('type') === 'password' ? 'text' : 'password'; 

                passwordInput.attr('type', type);
                confirmInput.attr('type', type);

                $(this).toggleClass('bi-eye bi-eye-slash');
            });

            $('#registerForm').on('submit', function(e) {
                e.preventDefault();

                const button = $('button[type="submit"]');
                button.attr('disabled', true).text("Hesap oluşturuluyor...");

                const data = $(this).serialize();

                $.ajax({
                    url: '/Auth/Register',
                    method: 'POST',
                    data: data,
                    success: function(response) {
                        if (response.success) {
                            $('#alert-message')
                                .removeClass('d-none alert-danger show')
                                .addClass('alert-success')
                                .text(response.message);
                            
                            setTimeout(() => {
                                $('#alert-message').addClass("show");
                            }, 10);

                            setTimeout(() => {
                                window.location.href = '/Auth/Login';
                            }, 1500);
                        }
                        else {
                            $('#alert-message')
                                .removeClass('d-none alert-success show')
                                .addClass('alert-danger')
                                .text(response.message);
                            
                            setTimeout(() => {
                                $('#alert-message').addClass("show");
                            }, 10);
                        }
                    },
                    error: function(xhr) {
                        $('#alert-message')
                            .removeClass('d-none alert-success show')
                            .addClass('alert-danger')
                            .text("Beklenmedik bir hata oluştu.")
                        
                        setTimeout(() => {
                            $('#alert-message').addClass("show");
                        }, 10);
                    },
                    complete: function() {
                        button.attr('disabled', false).text('Kayıt ol');
                    }
                });
            });
        });
    </script>
</body>
</html>