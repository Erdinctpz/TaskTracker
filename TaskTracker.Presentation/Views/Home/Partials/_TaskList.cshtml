@using TaskTracker.Application.DTOs
@model List<TaskDto>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        <i class="bi bi-info-circle me-2"></i>
        Henüz görev oluşturmamışsınız. Görev oluşturmak için yukarıdaki butonu kullanabilirsiniz.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Başlık</th>
                    <th>Öncelik</th>
                    <th>Oluşturulma</th>
                    <th>Son Tarih</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@item.Title</td>
                        <td>
                            @switch (item.Priority)
                            {
                                case 1:
                                    <span class="badge bg-success">Düşük</span>
                                    break;
                                case 2:
                                    <span class="badge bg-info">Orta</span>
                                    break;
                                case 3:
                                    <span class="badge bg-warning text-dark">Yüksek</span>
                                    break;
                                case 4:
                                    <span class="badge bg-danger">Acil</span>
                                    break;
                            }
                        </td>
                        <td>@item.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>@(item.Deadline.HasValue ? item.Deadline.Value.ToString("dd.MM.yyyy") : "Yok")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-info me-1" onclick="showTaskInfo(@(item.Id))">
                                <i class="bi bi-eye"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-warning me-1" onclick="openEditModal(@(item.Id))">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-outline-danger" onclick="deleteTask(@(item.Id))">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}